}
function obterAlocacaoDestinosFullTime(token,operacaoId){var s=obterSessao_(token);exigirAdmin_(s);operacaoId=String(operacaoId||'').trim();if(!operacaoId)throw new Error('Informe a operação.');return ftAlocData_(operacaoId);}
