  var capacityByDest={};items.forEach(function(x){var c=candBy[String(x.participacaoId)];capacityByDest[x.destinoId]=(capacityByDest[x.destinoId]||0)+c.capacidade;});var added=0,slotPosition={};items.forEach(function(x){var c=candBy[String(x.participacaoId)],old=oldBy[c.participacaoId],totalCap=capacityByDest[x.destinoId],reference=destBy[x.destinoId].volume*(totalCap>0?c.capacidade/totalCap:0.5);slotPosition[x.destinoId]=(slotPosition[x.destinoId]||0)+1;if(old&&String(old.DESTINO_ID)===String(x.destinoId)){sh.getRange(old._row,map.TONELADAS_REFERENCIA+1).setValue(reference);sh.getRange(old._row,map.POSICAO_DESTINO+1).setValue(slotPosition[x.destinoId]);sh.getRange(old._row,map.ATUALIZADO_EM+1).setValue(now);return;}var obj={ID:Utilities.getUuid(),OPERACAO_ID:opId,DESTINO_ID:x.destinoId,PARTICIPACAO_ID:c.participacaoId,CONJUNTO_ID:c.conjuntoId,MOTORISTA_ID:c.motoristaId,TONELADAS_REFERENCIA:reference,POSICAO_DESTINO:slotPosition[x.destinoId],STATUS:'ATIVA',CRIADO_EM:now,ATUALIZADO_EM:now,REGISTRADO_POR:session.login||session.nome||'ADMIN',MOTIVO:'Distribuição por destino confirmada pelo Bruno.'};var row=new Array(sh.getLastColumn()).fill('');Object.keys(obj).forEach(function(k){if(map[ftAlocNorm_(k)]!==undefined)row[map[ftAlocNorm_(k)]]=obj[k];});sh.appendRow(row);added++;});
