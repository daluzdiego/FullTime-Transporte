 var candidates=parts.map(function(p){var set=sBy[String(p.CONJUNTO_ID||'')]||{},did=String(p.MOTORISTA_ID||set.MOTORISTA_ID||''),d=dBy[did]||{},st=String(p.STATUS_PARTICIPACAO||'').toUpperCase();return {participacaoId:String(p.ID||''),conjuntoId:String(p.CONJUNTO_ID||''),motoristaId:did,nome:String(d.NOME_COMPLETO||d.NOME||did),status:st,capacidade:ftAlocNum_(set.CAPACIDADE_UTIL_TONELADAS),bloqueado:['SAIU','EM_VIAGEM','RETORNOU'].indexOf(st)>=0};}).filter(function(x){return x.participacaoId&&x.motoristaId;});
