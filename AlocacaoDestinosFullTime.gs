  var used={},counts={};items.forEach(function(x){var d=String(x.destinoId||''),p=String(x.participacaoId||''),c=candBy[p];if(!destBy[d])throw new Error('Destino inválido.');if(!c)throw new Error('Selecione motorista com convocação aceita.');if(used[c.motoristaId])throw new Error('O mesmo motorista não pode ocupar duas vagas: '+c.nome+'.');used[c.motoristaId]=true;counts[d]=(counts[d]||0)+1;if(counts[d]>2)throw new Error('Cada destino aceita dois motoristas.');});
