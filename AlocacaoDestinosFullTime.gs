  items.forEach(function(x){var c=candBy[String(x.participacaoId)],old=oldBy[c.participacaoId];if(c.bloqueado&&old&&String(old.DESTINO_ID)!==String(x.destinoId))throw new Error('O motorista '+c.nome+' já iniciou o deslocamento. Seu destino não pode ser alterado.');});
